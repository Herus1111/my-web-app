GET http://localhost:8080/growdent/events

//Tests für Friendships
### //Freundschaftsanfrage senden (Student 1 und Student 2)
POST http://localhost:8080/growdent/friendships/request?studentId=1&friendId=3
### //Freundschaften abrufen
GET http://localhost:8080/growdent/friendships/1
### //Anfrage annehmen
PUT http://localhost:8080/growdent/friendships/accept?studentId=1&friendId=2
### //Anfrage ablehnen (gleich zu löschen)
POST http://localhost:8080/growdent/friendships/decline?studentId=1&friendId=3
### //Freundschaft löschen
DELETE http://localhost:8080/growdent/friendships/delete?studentId=1&friendId=2
