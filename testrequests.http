
### 1. show all shops
GET http://localhost:8080/growdent/shops

### 2. insert shop
POST http://localhost:8080/growdent/shops
Content-Type: application/json

{
  "sellingItemsCount": 67
}

### 3. show shop with id=1
GET http://localhost:8080/growdent/shops/1

### Use of mulitvalue attributes (example with user and array)
POST http://localhost:8080/growdent/users
Content-Type: application/json

{
  "firstName": "Max",
  "lastName": "Mustermann",
  "level": 3,
  "status": "Aktiv",
  "attendedEvents": [
    "Zahnmedizin-Kongress 2024",
    "Labor-Workshop Grundlagen",
    "Sommerfest"
  ],
  "statistics": [
    "5 Logins diese Woche",
    "3 Feedbacks geschrieben"
  ]
}
