# General backend config
PORT=8080

# Backend database config
SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/growdent
SPRING_DATASOURCE_USERNAME=growdent
SPRING_DATASOURCE_PASSWORD=password
# Alternative if your cloud provider exposes a single DATABASE_URL
# DATABASE_URL=jdbc:postgresql://<host>:5432/<database>?user=<user>&password=<password>

# CORS for frontend domains (comma-separated list)
CORS_ALLOWED_ORIGINS=https://your-frontend-domain.example.com,http://localhost:3000,http://127.0.0.1:3000

# Frontend config (CRA/React) - set during build or runtime in your deployment platform
REACT_APP_API_URL=https://your-backend-domain.example.com/growdent

# Optional: if you deploy frontend under same domain with a proxy, you can omit REACT_APP_API_URL and use /growdent instead
# REACT_APP_API_URL=/growdent
